{
  "name": "billflow",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "create-admin": "prisma db push && tsx scripts/create-admin.ts",
    "prod": "node scripts/prod.js",
    "prod:start": "pm2 start ecosystem.config.js",
    "prod:stop": "pm2 stop ecosystem.config.js",
    "prod:restart": "pm2 restart ecosystem.config.js",
    "prod:reload": "next build && pm2 reload ecosystem.config.js",
    "prod:status": "pm2 status",
    "prod:logs": "pm2 logs billflow"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^2.4.3",
    "better-auth": "^1.7.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "jose": "^6.2.12",
    "lucide-react": "^0.475.0",
    "next": "^15.2.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.1",
    "tailwind-merge": "^3.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "pm2": "^7.0.4",
    "postcss": "^8.5.28",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "postcss": "^8.5.28",
    "deepmerge-ts": "^8.0.2",
    "js-yaml": "^4.3.2"
  }
}
